<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <ExcludeByFile>**/bin/**/*.cs;**/obj/**/*.cs</ExcludeByFile>
          <ExcludeByAttribute>ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <!-- Exclude the compiler-synthesized top-level-statements Program
               class. The AotSmoke project uses top-level statements as its
               entry point; the compiler emits a `AutoGeneratedProgram`
               wrapper that has no accessible source and can't be reached
               by a coverage-collecting `dotnet test`. It shows as 0% and
               gates the Stage 1 coverage floor for no useful signal. -->
          <Exclude>[*]AutoGeneratedProgram</Exclude>
          <!-- Include test assemblies in coverage output — the fleet policy
               (#218) treats test-code line coverage as first-class: dead
               test helpers, unreachable branches, and fakes nobody calls
               all become visible in Summary.txt. [ExcludeFromCodeCoverage]
               remains the last resort after "write a test" and "refactor
               to make it testable". -->
          <IncludeTestAssembly>true</IncludeTestAssembly>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
