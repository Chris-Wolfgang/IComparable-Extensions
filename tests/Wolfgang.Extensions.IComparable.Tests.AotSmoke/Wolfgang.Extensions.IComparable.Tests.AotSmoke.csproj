<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- The point of this project: prove the library survives Native-AOT +
		     trimming end-to-end. If any AOT-hostile pattern (dynamic generic
		     instantiation, reflection on names the trimmer can't see, runtime
		     code generation) sneaks in, `dotnet publish` here fails or the
		     published binary faults at startup. -->
		<PublishAot>true</PublishAot>
		<PublishTrimmed>true</PublishTrimmed>
		<StripSymbols>true</StripSymbols>
		<InvariantGlobalization>true</InvariantGlobalization>

		<!-- Not packed, not run as a test — just publish + execute. -->
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Wolfgang.Extensions.IComparable\Wolfgang.Extensions.IComparable.csproj" />
	</ItemGroup>

</Project>
